# Configuration de l'application Napoleon Hill AI

# Clé API Google Gemini
# Obtenez votre clé sur : https://aistudio.google.com/app/apikey
# IMPORTANT: Le préfixe VITE_ est requis pour que Vite expose la variable au client
VITE_GEMINI_API_KEY=votre_cle_api_ici

# Mode développement (désactive le paywall et augmente la limite de messages)
# Mettre à 'true' pour activer, 'false' ou supprimer pour désactiver
VITE_DEV_MODE=true

# ─── APPLE DEVELOPER (pour Fastlane / App Store) ───────────────────────────
# Votre Apple ID (email du compte Apple Developer)
APPLE_ID=your-apple-id@example.com

# Team ID (visible dans developer.apple.com → Membership)
APPLE_TEAM_ID=XXXXXXXXXX

# App Store Connect Team ID (si différent)
ITC_TEAM_ID=XXXXXXXXXX

# App ID numérique Apple (visible dans App Store Connect après création de l'app)
APPLE_APP_ID=000000000

# ─── APP STORE CONNECT API KEY (recommandé pour l'automatisation) ──────────
# Générer dans App Store Connect → Utilisateurs et Accès → Clés → Clés API
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Chemin vers le fichier .p8 téléchargé depuis App Store Connect
ASC_KEY_FILEPATH=./AuthKey_XXXXXXXXXX.p8

# ─── MATCH (CERTIFICATS AUTOMATIQUES) ─────────────────────────────────────
# URL du repo Git privé pour stocker les certificats signés
MATCH_GIT_URL=git@github.com:BenjaminDevOps/napoleon-app-certs.git
# Mot de passe pour chiffrer les certificats dans le repo
MATCH_PASSWORD=your-secure-password
